@startuml
skinparam classAttributeIconSize 0
skinparam monochrome true
skinparam shadowing false

package "Tarjetas CRC - HU-02 & HU-01" {

    class "GrupoTrabajo\n(HU-02)" as GrupoTrabajo <<CRC>> {
        -- Responsabilidades --
        * Registrar un grupo por afinidad o sorteo
        * Mapear nombre, actividad y lista de integrantes
        * Impedir integrantes duplicados
        * Validar y respetar el tamaño máximo
        * Garantizar la inmutabilidad de los datos
        -- Colaboradores --
        * Ninguno (Clase de Dominio autónoma)
    }

    class "CalendarioAcademico\n(HU-01)" as Calendario <<CRC>> {
        -- Responsabilidades --
        * Consultar eventos de una materia (clases, entregas, suspensiones)
        * Reflejar suspensiones o cambios de horario
        * Mostrar datos de fecha, horario y descripción
        * Notificar cuando no existen eventos registrados
        -- Colaboradores --
        * EventoAcademico
    }

    class "EventoAcademico\n(HU-01)" as Evento <<CRC>> {
        -- Responsabilidades --
        * Almacenar tipo de evento (clase, tarea, suspensión)
        * Almacenar fecha, horario y descripción
        -- Colaboradores --
        * Ninguno
    }

}
@enduml